{
  "mcpServers": {
    "intel": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/intel/index.cjs"],
      "env": {
        "PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
        "NODE_ENV": "production"
      }
    },
    "analytics": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/analytics/index.cjs"],
      "alwaysLoad": true,
      "env": {
        "PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
        "NODE_ENV": "production"
      }
    },
    "connect": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/connect/index.cjs"],
      "env": {
        "PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
        "NODE_ENV": "production"
      }
    }
  }
}
