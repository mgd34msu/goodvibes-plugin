{
  "name": "@goodvibes/analytics-engine",
  "version": "0.1.0",
  "description": "Session intelligence daemon and MCP server for goodvibes precision-engine",
  "type": "module",
  "engines": { "node": ">=18" },
  "main": "dist/index.js",
  "bin": {
    "analytics-mini": "dist/mini.js",
    "analytics-full": "dist/full.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx src/index.ts",
    "mini": "tsx src/tui/mini/renderer.ts",
    "full": "tsx src/tui/full/app.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chokidar": "^4.0.3",
    "ink": "^5.2.0",
    "react": "^18.3.1",
    "sql.js": "^1.12.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@types/react": "^18.3.18",
    "@types/sql.js": "^1.4.9",
    "esbuild": "^0.27.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.0"
  }
}
