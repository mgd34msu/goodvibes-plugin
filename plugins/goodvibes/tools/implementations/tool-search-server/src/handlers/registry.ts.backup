  get_skill_content: noContext(handleGetSkillContent),
  get_agent_content: noContext(handleGetAgentContent),
  skill_dependencies: (ctx, args) =>
    handleSkillDependencies(
      ctx.skillsIndex,
      ctx.skillsRegistry,
      args as SkillDependenciesArgs,
    ),
};

