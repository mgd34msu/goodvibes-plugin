{
  "name": "@goodvibes/runtime-engine",
  "version": "1.1.0",
  "description": "Runtime engine MCP server for GoodVibes — IPC, workflows, persistence, triggers",
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
