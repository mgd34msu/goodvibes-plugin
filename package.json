{
  "name": "goodvibes-plugin",
  "version": "2.0.0",
  "private": true,
  "description": "GoodVibes — structure-aware code intelligence, session cost analytics, and an API workbench for Claude Code",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/intel/build.mjs && node packages/analytics/build.mjs && node packages/connect/build.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:workspaces": "npm run lint --workspaces --if-present",
    "postinstall": "echo 'Run npm run build to build the server bundles'",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.53.1"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "minimatch@3.1.5": true,
    "minimatch@10.2.4": true,
    "minimatch@9.0.9": true
  }
}
