{
  "name": "goodvibes-plugin",
  "version": "1.0.1",
  "private": true,
  "description": "VibePlug - Claude Code Plugin Framework",
  "type": "module",
  "workspaces": [
    "plugins/goodvibes",
    "plugins/goodvibes/hooks/scripts"
  ],
  "scripts": {
    "build": "npm run build --workspace=plugins/goodvibes",
    "build:hooks": "npm run build --workspace=plugins/goodvibes/hooks/scripts",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:workspaces": "npm run lint --workspaces --if-present",
    "postinstall": "echo 'Run npm run build to build all workspaces'",
    "cost-analysis": "node plugins/goodvibes/hooks/scripts/dist/cost-analysis-cli.js",
    "release": "./scripts/release.sh",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.53.1"
  }
}
